    "eslint-plugin-jest": ">=29.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjw-lint/eslint-config-tjw-jest.git"
  },
  "homepage": "https://github.com/tjw-lint/eslint-config-tjw-jest#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tjw-lint/eslint-config-tjw-jest/issues"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.2"
    }
  }
