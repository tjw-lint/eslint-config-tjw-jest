{
  "name": "eslint-config-tjw-jest",
  "version": "4.0.0",
  "type": "module",
  "main": "index.js",
  "description": "The Jared Wilcurt's Jest Linting rules",
  "author": "The Jared Wilcurt",
  "scripts": {
    "lint": "eslint manual-testing.js"
  },
  "keywords": [
    "tjw",
    "jest",
    "eslint",
    "lint"
